{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sportstech-staging",
  "account_id": "e6ef673047a124edf93818f0a51ace71",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "staging",
    "ACCESS_TEAM_DOMAIN": "jolly-fog-e8df.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "ee3e0d310a6943197b1764a7c89ec1a242de63d4827ea64879a128aa6e2d8120",
    "PRINT_QUEUE_ENABLED": "true",
    "MUTATIONS_ENABLED": "false"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/admin*", "/print*"]
  },
  "version_metadata": {
    "binding": "VERSION"
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "sportstech-staging-media" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sportstech-staging",
      "database_id": "e0c1ab2a-79c6-44f1-8e52-dc58f830c5f2",
      "migrations_dir": "worker/migrations"
    }
  ]
}
