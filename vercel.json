{
    "redirects": [
        {
            "source": "/:path*",
            "has": [{ "type": "host", "value": "sports-tech-manager.vercel.app" }],
            "destination": "https://www.sportstechph.store/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}