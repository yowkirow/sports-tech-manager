{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sportstech-production",
  "account_id": "e6ef673047a124edf93818f0a51ace71",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "limits": {
    "cpu_ms": 1000
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "jolly-fog-e8df.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "",
    "PRINT_QUEUE_ENABLED": "false",
    "MUTATIONS_ENABLED": "false"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/admin*", "/print*"]
  },
  "version_metadata": {
    "binding": "VERSION"
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "sportstech-production-media" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sportstech-production",
      "database_id": "582f755c-fced-4778-bdc4-af93c2f7c22c",
      "migrations_dir": "worker/migrations"
    }
  ]
}
